PORT=4173
DEMO_MODE=1
# Live hosting: set DEMO_MODE=0 and use a fresh database.
# PUBLIC_ORIGIN=https://clan.example.com
# DATABASE_URL=postgresql://user:password@hostname:port/db?sslmode=verify-full
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# RESEND_API_KEY=
# REPLAY_EMAIL_FROM=FaZe Clan <hello@clan.example.com>
# VULTR_API_KEY=
# VULTR_INSTANCE_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# OPERATOR_EMAILS=
# REVIEWER_EMAILS=
# MATCH_INGEST_TOKEN=
# CAMPAIGN_BUDGET_CENTS=25000
# PATCH_FEED_URL=
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_RECEIPT_AUTHORITY=
# SOLANA_KEYPAIR_FILE=
# HERO_VIDEO_URL=/hero.mp4
# MEMBER_VIDEO_URL=
# REWIND_VIDEO_URL=
# CONTENT_FILE=./content.json

# Fan programs. Stripe membership checkout accepts test keys only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_OG_MONTH_PRICE=
STRIPE_OG_YEAR_PRICE=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Long random value for keyed vote-pattern hashes. Set before enabling live voting.
PROGRAM_FRAUD_SECRET=
NEXT_JUDGE_EMAILS=

# Ask FaZe. The key is shared with the existing Gemini integration.
# For chat, leave GEMINI_CHAT_MODEL unset to use the common model setting.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
ALLOW_GENERAL_QUESTIONS=false
ASK_FAZE_DAILY_CAP=50
ASK_FAZE_RETENTION_DAYS=30
ASK_FAZE_MAX_CHATS=20
ASK_FAZE_MAX_TURNS=32
ASK_FAZE_MAX_REPLY_CHARS=2200
